              "pm.test(\"[Dominio] Entrega las 2 preguntas con 4 opciones cada una\", () => {",
              "  pm.expect(j.preguntas).to.have.lengthOf(2);",
              "  pm.expect(j.preguntas.every(p => p.opciones.length === 4)).to.be.true;",
              "});",
              "pm.test(\"[Dominio] El tiempo restante no supera el límite de 300 s\", () => pm.expect(j.restanteSeg).to.be.within(1, 300));",
              "pm.test(\"[Dominio] No filtra la opción correcta al estudiante\", () => pm.expect(JSON.stringify(j)).to.not.include(\"opcionCorrecta\"));",
              "pm.environment.set(\"preguntaId1\", j.preguntas[0].id);",
              "pm.environment.set(\"preguntaId2\", j.preguntas[1].id);"
            ]
          }
