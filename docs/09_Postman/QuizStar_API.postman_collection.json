          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "const lista = pm.response.json();",
              "const mio = lista.find(q => q.id === pm.environment.get(\"quizId\"));",
              "pm.test(\"[Dominio] El quiz asignado aparece en la lista del estudiante\", () => pm.expect(mio).to.not.be.undefined);",
              "pm.test(\"[Dominio] Su estado inicial es SIN_INICIAR\", () => pm.expect(mio.estadoIntento).to.eql(\"SIN_INICIAR\"));",
              "pm.test(\"[Dominio] La lista no revela la opción correcta\", () => pm.expect(JSON.stringify(lista)).to.not.include(\"opcionCorrecta\"));"
