{
  "info": {
    "name": "QuizStar API - Pruebas de calidad",
    "description": "21 solicitudes encadenadas con verificaciones post-respuesta. Ejecutar en orden con el Collection Runner y el entorno QuizStar Local. Las verificaciones marcadas [Dominio] comprueban reglas del negocio (roles, calificación, no repetir quiz, no filtrar la respuesta correcta).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Login profesor correcto (SWR-AUTH-001)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"Devuelve un accessToken de texto\", () => pm.expect(j.accessToken).to.be.a(\"string\").and.not.empty);",
              "pm.test(\"[Dominio] El rol del usuario es PROFESOR\", () => pm.expect(j.usuario.rol).to.eql(\"PROFESOR\"));",
              "pm.test(\"[Dominio] No expone el hash de la contraseña\", () => pm.expect(JSON.stringify(j)).to.not.include(\"passwordHash\"));",
              "pm.environment.set(\"tokenProfe\", j.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"{{profeCorreo}}\",\n  \"password\": \"{{profePassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
